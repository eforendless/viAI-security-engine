{
  "name": "desktop",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:engine": "npm --prefix .. start",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173 && electron .",
    "desktop": "concurrently --kill-others-on-fail \"npm:dev:engine\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "npm --prefix .. run build && tsc -b && vite build && tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); const pkg=require('./package.json'); fs.writeFileSync('dist-electron/package.json', JSON.stringify({name:pkg.name,version:pkg.version,type:'commonjs',main:'main.js'},null,2)); fs.copyFileSync('electron/splash.html', 'dist-electron/splash.html')\"",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "publish:github": "npm run build && electron-builder --win nsis --x64 --publish always",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "test": "npm run build && node scripts/test-assessment-presentation.mjs && node scripts/test-history-interactions.mjs && node scripts/test-realtime-search.mjs && node scripts/test-scan-completion.mjs && node --test dist-electron/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.eforendless.viai",
    "productName": "viAI Security Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/viai-logodone.png",
      "public/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "engine/dist"
      },
      {
        "from": "../package.json",
        "to": "engine/package.json"
      },
      {
        "from": "../rules",
        "to": "engine/rules"
      },
      {
        "from": "../database/reputation.example.json",
        "to": "engine/database/reputation.json"
      },
      {
        "from": "../database/trusted-publishers.json",
        "to": "engine/database/trusted-publishers.json"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "viAI.Security.Engine.Setup.${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eforendless",
        "repo": "viAI-security-engine",
        "releaseType": "release"
      }
    ]
  }
}
